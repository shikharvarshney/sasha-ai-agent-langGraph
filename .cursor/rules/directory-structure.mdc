│   └── tasks.yaml              # Task prompt templates
│
├── storage/                    # Data persistence layer
│   ├── __init__.py
│   ├── redis_store.py          # Redis state storage
│   └── rag_storage.py          # RAG document storage
│
├── tools/                      # LangChain tools
│   ├── __init__.py
│   ├── pricing_tool.py         # Pricing calculation tools
│   ├── feasibility_tool.py     # Feasibility check tools
│   ├── order_tool.py           # Order management tools
│   └── email_tool.py           # Email sending tools
│
└── utils/                      # Utility modules
    ├── __init__.py
